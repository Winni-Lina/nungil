<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nungil.domain.chat.ChatHistoryMapper">

    <resultMap id="ChatHistoryResultMap" type="com.nungil.domain.chat.ChatHistoryVO">
        <id     property="messageId"   column="message_id"/>
        <result property="guardianId"  column="guardian_id"/>
        <result property="userIdx"     column="user_idx"/>
        <result property="scheduleId"  column="schedule_id"/>
        <result property="stepIndex"   column="step_index"/>
        <result property="chatMode"    column="chat_mode"/>
        <result property="sender"      column="sender"/>
        <result property="message"     column="message"/>
        <result property="intent"      column="intent"/>
        <result property="createdAt"   column="created_at"/>
    </resultMap>

    <!-- 저장. nullable 컬럼은 Oracle null 바인딩 예외 방지를 위해 jdbcType 지정 -->
    <insert id="insert" parameterType="com.nungil.domain.chat.ChatHistoryVO"
            useGeneratedKeys="true" keyProperty="messageId" keyColumn="message_id">
        INSERT INTO CHAT_HISTORY
            (guardian_id, user_idx, schedule_id, step_index, chat_mode, sender, message, intent)
        VALUES
            (#{guardianId}, #{userIdx},
             #{scheduleId,jdbcType=NUMERIC}, #{stepIndex,jdbcType=NUMERIC},
             #{chatMode}, #{sender}, #{message}, #{intent,jdbcType=VARCHAR})
    </insert>

    <!-- 일정별 조회: 4개 조건 일치, created_at 오름차순. scheduleId null이면 IS NULL -->
    <select id="findMessages" resultMap="ChatHistoryResultMap">
        SELECT * FROM CHAT_HISTORY
        WHERE guardian_id = #{guardianId}
          AND user_idx    = #{userIdx}
          AND chat_mode   = #{chatMode}
        <choose>
            <when test="scheduleId != null">
          AND schedule_id = #{scheduleId}
            </when>
            <otherwise>
          AND schedule_id IS NULL
            </otherwise>
        </choose>
        ORDER BY created_at ASC, message_id ASC
    </select>

</mapper>
